#!/usr/bin/env python3

"""
TITLE:
    Simulate ground truth to validate SCM

USAGE: 
    snakemake --configfile config.yaml --profile /path/to/profile_dir/ -p # slurm
    snakemake --configfile config.yaml --use-conda --cores 16 -p # local
"""

#--- IMPORTS ---#
import hashlib
import os
import pathlib

#--- CONFIGURATION ---#
# configure shell behavior for all rules
shell.executable("/bin/bash")
shell.prefix("set -euo pipefail;")

# Create a log directory
pathlib.Path("logs/").mkdir(parents=True, exist_ok=True)

#--- SIMULATION GRID ---#
# One simulation per (n, t, viol_mult, rep): n sampled cells, t years,
# viol_mult x the expected number of ISM violations (0 = none), and rep = 1..sim_reps.
SAMPLE_SIZES = config["n"]
AGES         = config["t"]
VIOL_MULTS   = config["viol_mult"]
REPS         = list(range(1, config["sim_reps"] + 1))

wildcard_constraints:
    n         = r"\d+",
    t         = r"\d+",
    viol_mult = r"[0-9.]+",
    rep       = r"\d+"

def sim_seed(wildcards):
    """Seed unique to each simulation, derived from its wildcards."""
    key = f"{wildcards.n}_{wildcards.t}_{wildcards.viol_mult}_{wildcards.rep}"
    return int(hashlib.md5(key.encode()).hexdigest()[:7], 16) # < 2**28

def sim_mem_mb(wildcards, attempt):
    """Peak memory (MB) requested for one simulation, as a function of sample
    size n (and age t).

    Cost driver: the (mutation records x samples) genotype matrices.
    records ~ t * (190 + 11.25 * n)   (fit to 6 runs, within ~15%)
    cells   = records * (n + 1)

    Peak process RSS of a whole run, measured after create_mut_df() was
    changed to rbind() once instead of once per edge:
        macOS:  n=50  t=40 (  1.5M cells):  3.15 GB
        macOS:  n=100 t=40 (  5.3M cells):  3.28 GB
        macOS:  n=200 t=40 ( 19.6M cells):  6.75 GB   (~245 B/cell)
        SLURM:  n=500 t=80 (233.1M cells): 23.66 GB   (~90 B/cell; sacct MaxRSS)
    """
    n, t = int(wildcards.n), int(wildcards.t)
    cells = t * (190 + 11.25 * n) * (n + 1)
    est_mb = max(3500, 2000 + cells * 100 / 1e6) * 1.2
    return int(est_mb * (1 + 0.5 * (attempt - 1)))

def fit_sites(wildcards, input):
    """Number of VCF records (= alignment sites) for a simulation"""
    try:
        return int(open(input.nsites).read())
    except (OSError, ValueError):
        n, t = int(wildcards.n), int(wildcards.t)
        return min(t * (190 + 11.25 * n), 520 * n)

def fit_threads(wildcards, input):
    """raxml-ng splits sites across threads"""
    return max(1, min(16, round(fit_sites(wildcards, input) / 8500)))

def fit_mem_mb(wildcards, input, attempt):
    """Peak memory (MB) requested for one CellPhy tree evaluation.
    Each retry asks for 50% more."""
    est_mb = max(2000, fit_sites(wildcards, input) * 2 * int(wildcards.n) * 200 / 1e6)
    return int(est_mb * (1 + 0.5 * (attempt - 1)))

#--- RULES ---#
localrules:
    clone_rsimpop,
    clone_cellphy

rule all:
    input:
        "resources/mask.bed",
        "results/rsimpop_installed.txt",
        expand("results/sims/n{n}_t{t}_v{viol_mult}_r{rep}.raxml.bestModel",
               n=SAMPLE_SIZES, t=AGES, viol_mult=VIOL_MULTS, rep=REPS)

rule download_mask:
# note that this will not work on discovery because of port22 closure; predownload instead
    output: "resources/mask.bed"
    params:
        url = config["accessibility_mask"]
    shell:
        """
        wget -O {output} {params.url}
        """

rule clone_rsimpop:
    output: 
        repo = directory("results/rsimpop")
    params:
        repo = config["rsimpop_repo"],
        commit = config["rsimpop_commit"]
    shell:
        """
        git clone {params.repo} {output}
        git -C {output} checkout {params.commit}
        """

rule clone_cellphy:
    output: 
        repo = directory("results/cellphy"),
        script = "results/cellphy/cellphy.sh"
    params:
        repo = config["cellphy_repo"],
        commit = config["cellphy_commit"]
    shell:
        """
        git clone {params.repo} {output.repo}
        git -C {output.repo} checkout {params.commit}
        """

rule install_rsimpop:
    input:
        src = "results/rsimpop",
        env = workflow.source_path("envs/simulate_history.yaml")
    output: "results/rsimpop_installed.txt"
    conda: "envs/simulate_history.yaml"
    threads: 4
    shell:
        """
        MAKEFLAGS="-j{threads}" R CMD INSTALL \\
            --library="$(Rscript -e 'cat(.Library)')" {input.src}
        Rscript -e 'library(rsimpop); cat("rsimpop", as.character(packageVersion("rsimpop")), "\\n")' > {output}
        """

# One job per (n, t, viol_mult, rep). viol_mult = 0 means no ISM violations
rule simulate_ground_truth:
    input:
        mask    = "resources/mask.bed",
        rsimpop = "results/rsimpop_installed.txt",
        script = "workflow/bin/simulate_ground_truth.Rscript"
    output:
        vcf   = "results/sims/n{n}_t{t}_v{viol_mult}_r{rep}.vcf.gz",
        nwk   = "results/sims/n{n}_t{t}_v{viol_mult}_r{rep}.nwk",
        truth = "results/sims/n{n}_t{t}_v{viol_mult}_r{rep}.truth.rds"
    params:
        out_dir     = "results/sims",
        prefix      = "n{n}_t{t}_v{viol_mult}_r{rep}",
        seed        = sim_seed,
        pop_size    = config["pop_size"],
        driver_prop = lambda wildcards: "--driver_prop 0.5" if float(wildcards.viol_mult) > 0 else ""
    conda: "envs/simulate_history.yaml"
    threads: 1
    resources:
        mem_mb = sim_mem_mb
    log: "logs/simulate_ground_truth/n{n}_t{t}_v{viol_mult}_r{rep}.log"
    shell:
        """
        Rscript {input.script} \\
            --sample_size {wildcards.n} \\
            --age {wildcards.t} \\
            --ism_multiplier {wildcards.viol_mult} {params.driver_prop} \\
            --seed {params.seed} \\
            --pop_size {params.pop_size} \\
            --mask {input.mask} \\
            --out_dir {params.out_dir} \\
            --prefix {params.prefix} > {log} 2>&1
        """

# Cheap pass that counts the VCF records, so fit_Q_cellphy can size itself
# from the real alignment instead of a model.
rule count_sites:
    input: rules.simulate_ground_truth.output.vcf
    output: temp("results/sims/n{n}_t{t}_v{viol_mult}_r{rep}.nsites")
    shell:
        """
        gzip -dc {input} | awk '!/^#/ {{n++}} END {{print n+0}}' > {output}
        """

rule fit_Q_cellphy:
    input:
        nsites = rules.count_sites.output[0],
        nwk = rules.simulate_ground_truth.output.nwk,
        vcf = rules.simulate_ground_truth.output.vcf,
        cellphy = rules.clone_cellphy.output.script
    output:
        bestTree = "results/sims/n{n}_t{t}_v{viol_mult}_r{rep}.raxml.bestTree",
        bestModel = "results/sims/n{n}_t{t}_v{viol_mult}_r{rep}.raxml.bestModel"
    threads: fit_threads
    params:
        prefix = "results/sims/n{n}_t{t}_v{viol_mult}_r{rep}"
    resources:
        mem_mb = fit_mem_mb
    log: "logs/fit_Q_cellphy/n{n}_t{t}_v{viol_mult}_r{rep}.log"
    shell:
        """
        {input.cellphy} \\
            RAXML \\
            --evaluate \\
            --msa {input.vcf} \\
            --msa-format vcf \\
            --model GT10+FO \\
            --tree {input.nwk} \\
            --prefix {params.prefix} \\
            --threads {threads} \\
            --force perf_threads > {log} 2>&1
        """