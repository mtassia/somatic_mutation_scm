#!/usr/bin/env python3

"""
TITLE:
    Simulate ground truth to validate SCM

USAGE: 
    snakemake --configfile config.yaml --profile /path/to/profile_dir/ -p # slurm
    snakemake --configfile config.yaml --use-conda --cores 16 -p # local
"""

#--- IMPORTS ---#
import hashlib
import os
import pathlib

#--- CONFIGURATION ---#
# configure shell behavior for all rules
shell.executable("/bin/bash")
shell.prefix("set -euo pipefail;")

# Create a log directory
pathlib.Path("logs/").mkdir(parents=True, exist_ok=True)

#--- SIMULATION GRID ---#
# One simulation per (n, t, viol_mult, rep): n sampled cells, t years,
# viol_mult x the expected number of ISM violations (0 = none), and rep = 1..sim_reps.
SAMPLE_SIZES = config["n"]
AGES         = config["t"]
VIOL_MULTS   = config["viol_mult"]
REPS         = list(range(1, config["sim_reps"] + 1))

wildcard_constraints:
    n         = r"\d+",
    t         = r"\d+",
    viol_mult = r"[0-9.]+",
    rep       = r"\d+",
    chrom     = r"chr(?:[0-9]+|X)"

# SCM runs per chromosome. The production pipeline (smk/) stops at chr22; the
# simulated genomes are diploid on chrX like everywhere else, so it is included.
CHROMS  = [f"chr{c}" for c in range(1, 23)] + ["chrX"]
SCM_BIN = "../../../smk/workflow/bin"   # SCM scripts, relative to the launch directory (validation/)

def sim_seed(wildcards):
    """Seed unique to each simulation, derived from its wildcards."""
    key = f"{wildcards.n}_{wildcards.t}_{wildcards.viol_mult}_{wildcards.rep}"
    return int(hashlib.md5(key.encode()).hexdigest()[:7], 16) # < 2**28

def sim_mem_mb(wildcards, attempt):
    """Peak memory (MB) requested for one simulation, as a function of sample
    size n (and age t).

    Cost driver: the (mutation records x samples) genotype matrices.
    records ~ t * (190 + 11.25 * n)   (fit to 6 runs, within ~15%)
    cells   = records * (n + 1)

    Peak process RSS of a whole run, measured after create_mut_df() was
    changed to rbind() once instead of once per edge:
        macOS:  n=50  t=40 (  1.5M cells):  3.15 GB
        macOS:  n=100 t=40 (  5.3M cells):  3.28 GB
        macOS:  n=200 t=40 ( 19.6M cells):  6.75 GB   (~245 B/cell)
        SLURM:  n=500 t=80 (233.1M cells): 23.66 GB   (~90 B/cell; sacct MaxRSS)
    """
    n, t = int(wildcards.n), int(wildcards.t)
    cells = t * (190 + 11.25 * n) * (n + 1)
    est_mb = max(3500, 2000 + cells * 100 / 1e6) * 1.2
    return int(est_mb * (1 + 0.5 * (attempt - 1)))

def fit_sites(wildcards, input):
    """Number of VCF records (= alignment sites) for a simulation"""
    try:
        return int(open(input.nsites).read())
    except (OSError, ValueError):
        n, t = int(wildcards.n), int(wildcards.t)
        return min(t * (190 + 11.25 * n), 520 * n)

def fit_threads(wildcards, input):
    """raxml-ng splits sites across threads"""
    return max(1, min(16, round(fit_sites(wildcards, input) / 8500)))

def fit_mem_mb(wildcards, input, attempt):
    """Peak memory (MB) requested for one CellPhy tree evaluation.
    Each retry asks for 50% more."""
    est_mb = max(2000, fit_sites(wildcards, input) * 2 * int(wildcards.n) * 200 / 1e6)
    return int(est_mb * (1 + 0.5 * (attempt - 1)))

# hg38 chromosome lengths (Mb); records are spread over the genome roughly in
# proportion to length, so a chromosome holds ~length/total of a simulation's records.
CHROM_MB = {"chr1": 248.96, "chr2": 242.19, "chr3": 198.30, "chr4": 190.21,
            "chr5": 181.54, "chr6": 170.81, "chr7": 159.35, "chr8": 145.14,
            "chr9": 138.39, "chr10": 133.80, "chr11": 135.09, "chr12": 133.28,
            "chr13": 114.36, "chr14": 107.04, "chr15": 101.99, "chr16": 90.34,
            "chr17": 83.26, "chr18": 80.37, "chr19": 58.62, "chr20": 64.44,
            "chr21": 46.71, "chr22": 50.82, "chrX": 156.04}

def scm_mem_mb(wildcards, input, attempt):
    """Memory (MB) for one per-chromosome SCM job.

    A job loads its chromosome's VCF and builds one genotype-prior table per
    locus (compile_gt_states.snp), so memory scales with
        cells = records on the chromosome * (n + 1).
    records = exact total from count_sites * the chromosome's share of the
    genome (length-proportional, +20% for the mask's uneven coverage).

    Measured on macOS (peak RSS of vcfR read + compile_gt_states.snp, n=100):
        28k cells: 0.45 GB,  169k cells: 0.69 GB,  484k cells: 1.27 GB
    i.e. ~0.4 GB + 1.8 KB per cell and a prep time of ~50 us per cell.  Modelled
    here as 2 GB + 2.5 KB per cell (1.4x the measured slope as allowance for
    the Linux allocator and the 4 worker processes), plus 20% headroom.
    The measurements stop at 0.5M cells; n=500 chr1 is 5-12M cells, so this is
    an extrapolation: compare with `sacct` MaxRSS.  Retries add 50% each."""
    share = 1.2 * CHROM_MB[wildcards.chrom] / sum(CHROM_MB.values())
    cells = share * fit_sites(wildcards, input) * (int(wildcards.n) + 1)
    est_mb = max(4000, (2000 + cells * 2500 / 1e6) * 1.2)
    return int(est_mb * (1 + 0.5 * (attempt - 1)))

def scm_chrom_h5s(wildcards):
    """The per-chromosome h5 files of one simulation."""
    return expand("results/scm/n{n}_t{t}_v{v}_r{r}.{chrom}.h5",
                  n=wildcards.n, t=wildcards.t, v=wildcards.viol_mult,
                  r=wildcards.rep, chrom=CHROMS)

#--- RULES ---#
localrules:
    clone_rsimpop,
    clone_cellphy

rule all:
    input:
        "resources/mask.bed",
        "results/rsimpop_installed.txt",
        expand("results/scm/compare/n{n}_t{t}_v{viol_mult}_r{rep}.tsv",
               n=SAMPLE_SIZES, t=AGES, viol_mult=VIOL_MULTS, rep=REPS)


## -- setup -- ##

rule download_mask:
# note that this will not work on discovery because of port22 closure; predownload instead
    output: "resources/mask.bed"
    params:
        url = config["accessibility_mask"]
    shell:
        """
        wget -O {output} {params.url}
        """

rule clone_rsimpop:
    output: 
        repo = directory("results/rsimpop")
    params:
        repo = config["rsimpop_repo"],
        commit = config["rsimpop_commit"]
    shell:
        """
        git clone {params.repo} {output}
        git -C {output} checkout {params.commit}
        """

rule clone_cellphy:
    output: 
        repo = directory("results/cellphy"),
        script = "results/cellphy/cellphy.sh"
    params:
        repo = config["cellphy_repo"],
        commit = config["cellphy_commit"]
    shell:
        """
        git clone {params.repo} {output.repo}
        git -C {output.repo} checkout {params.commit}
        """

rule install_rsimpop:
    input:
        src = "results/rsimpop",
        env = workflow.source_path("envs/simulate_history.yaml")
    output: "results/rsimpop_installed.txt"
    conda: "envs/simulate_history.yaml"
    threads: 4
    shell:
        """
        MAKEFLAGS="-j{threads}" R CMD INSTALL \\
            --library="$(Rscript -e 'cat(.Library)')" {input.src}
        Rscript -e 'library(rsimpop); cat("rsimpop", as.character(packageVersion("rsimpop")), "\\n")' > {output}
        """

## -- simulate history -- ##

# One job per (n, t, viol_mult, rep). viol_mult = 0 means no ISM violations
rule simulate_ground_truth:
    input:
        mask    = "resources/mask.bed",
        rsimpop = "results/rsimpop_installed.txt",
        script = "workflow/bin/simulate_ground_truth.Rscript"
    output:
        vcf   = "results/sims/n{n}_t{t}_v{viol_mult}_r{rep}.vcf.gz",
        nwk   = "results/sims/n{n}_t{t}_v{viol_mult}_r{rep}.nwk",
        truth = "results/sims/n{n}_t{t}_v{viol_mult}_r{rep}.truth.rds"
    params:
        out_dir     = "results/sims",
        prefix      = "n{n}_t{t}_v{viol_mult}_r{rep}",
        seed        = sim_seed,
        pop_size    = config["pop_size"],
        driver_prop = lambda wildcards: "--driver_prop 0.5" if float(wildcards.viol_mult) > 0 else ""
    conda: "envs/simulate_history.yaml"
    threads: 1
    resources:
        mem_mb = sim_mem_mb
    log: "logs/simulate_ground_truth/n{n}_t{t}_v{viol_mult}_r{rep}.log"
    shell:
        """
        Rscript {input.script} \\
            --sample_size {wildcards.n} \\
            --age {wildcards.t} \\
            --ism_multiplier {wildcards.viol_mult} {params.driver_prop} \\
            --seed {params.seed} \\
            --pop_size {params.pop_size} \\
            --mask {input.mask} \\
            --out_dir {params.out_dir} \\
            --prefix {params.prefix} > {log} 2>&1
        """

## -- fit Q -- ##

# Cheap pass that counts the VCF records, so fit_Q_cellphy can size itself
rule count_sites:
    input: rules.simulate_ground_truth.output.vcf
    output: temp("results/sims/n{n}_t{t}_v{viol_mult}_r{rep}.nsites")
    shell:
        """
        gzip -dc {input} | awk '!/^#/ {{n++}} END {{print n+0}}' > {output}
        """

rule fit_Q_cellphy:
    input:
        nsites = rules.count_sites.output[0],
        nwk = rules.simulate_ground_truth.output.nwk,
        vcf = rules.simulate_ground_truth.output.vcf,
        cellphy = rules.clone_cellphy.output.script
    output:
        bestTree = "results/sims/n{n}_t{t}_v{viol_mult}_r{rep}.raxml.bestTree",
        bestModel = "results/sims/n{n}_t{t}_v{viol_mult}_r{rep}.raxml.bestModel"
    threads: fit_threads
    params:
        prefix = "results/sims/n{n}_t{t}_v{viol_mult}_r{rep}"
    resources:
        mem_mb = fit_mem_mb
    log: "logs/fit_Q_cellphy/n{n}_t{t}_v{viol_mult}_r{rep}.log"
    shell:
        """
        {input.cellphy} \\
            RAXML \\
            --evaluate \\
            --msa {input.vcf} \\
            --msa-format vcf \\
            --model GT10+FO \\
            --tree {input.nwk} \\
            --prefix {params.prefix} \\
            --threads {threads} \\
            --force perf_threads > {log} 2>&1
        """

## -- scm -- ##

# Split each ground-truth VCF by chromosome so every SCM job reads only its own
# chromosome instead of the whole file. 
rule split_vcf_by_chrom:
    input:
        vcf = rules.simulate_ground_truth.output.vcf
    output:
        temp(expand("results/scm/vcf/n{{n}}_t{{t}}_v{{viol_mult}}_r{{rep}}.{chrom}.vcf.gz",
                    chrom=CHROMS))
    params:
        chroms = " ".join(CHROMS),
        prefix = "results/scm/vcf/n{n}_t{t}_v{viol_mult}_r{rep}"
    conda: "envs/htslib.yaml"
    threads: 1
    shell:
        """
        tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
        gzip -dc {input.vcf} | bgzip -c > "$tmp/all.vcf.gz"
        tabix -p vcf "$tmp/all.vcf.gz"
        for c in {params.chroms}; do
            tabix -h "$tmp/all.vcf.gz" "$c" | bgzip -c > {params.prefix}.$c.vcf.gz
        done
        """

# Stochastic character mapping of one chromosome of one simulation, using the
# CellPhy-fitted tree and Q matrix.  The outgroup tip of every simulation is s1.
rule scm_chromosome:
    input:
        tree      = rules.fit_Q_cellphy.output.bestTree,
        model     = rules.fit_Q_cellphy.output.bestModel,
        nsites    = rules.count_sites.output[0],     # sizes mem_mb
        vcf       = "results/scm/vcf/n{n}_t{t}_v{viol_mult}_r{rep}.{chrom}.vcf.gz",
        script    = f"{SCM_BIN}/chromosome_scm.R",
        functions = f"{SCM_BIN}/SCM.smk.R"
    output:
        h5 = temp("results/scm/n{n}_t{t}_v{viol_mult}_r{rep}.{chrom}.h5")
    params:
        prefix = "results/scm/n{n}_t{t}_v{viol_mult}_r{rep}.{chrom}",
        reps   = config["scm_reps"]
    conda: "../../../../smk/workflow/envs/scm.yaml"
    threads: 4
    resources:
        mem_mb = scm_mem_mb
    log: "logs/scm_chromosome/n{n}_t{t}_v{viol_mult}_r{rep}.{chrom}.log"
    shell:
        """
        Rscript {input.script} \\
            -f {input.functions} \\
            -v {input.vcf} \\
            -t {input.tree} \\
            -m {input.model} \\
            -p {params.prefix} \\
            -o s1 \\
            -n {threads} \\
            -i {params.reps} \\
            -c {wildcards.chrom} > {log} 2>&1
        """

rule merge_scm_h5:
    input:
        h5_files  = scm_chrom_h5s,
        script    = f"{SCM_BIN}/merge_scm_h5.R",
        functions = f"{SCM_BIN}/SCM.smk.R"
    output:
        h5 = "results/scm/merged/n{n}_t{t}_v{viol_mult}_r{rep}.h5"
    params:
        h5_files_str = lambda wildcards, input: ",".join(input.h5_files)
    conda: "../../../../smk/workflow/envs/scm.yaml"
    resources:
        mem_mb = lambda wildcards, attempt: 4000 * attempt
    log: "logs/merge_scm_h5/n{n}_t{t}_v{viol_mult}_r{rep}.log"
    shell:
        """
        Rscript {input.script} \\
            -f {input.functions} \\
            -i {params.h5_files_str} \\
            -o {output.h5} > {log} 2>&1
        """

rule write_scm_tree:
    input:
        h5        = rules.merge_scm_h5.output.h5,
        tree      = rules.fit_Q_cellphy.output.bestTree,
        script    = f"{SCM_BIN}/write_burden_to_tree.R",
        functions = f"{SCM_BIN}/SCM.smk.R"
    output:
        tree = "results/scm/trees/n{n}_t{t}_v{viol_mult}_r{rep}.scm.nwk"
    conda: "../../../../smk/workflow/envs/scm.yaml"
    resources:
        mem_mb = lambda wildcards, attempt: 4000 * attempt
    log: "logs/write_scm_tree/n{n}_t{t}_v{viol_mult}_r{rep}.log"
    shell:
        """
        Rscript {input.script} \\
            --functions {input.functions} \\
            --input {input.h5} \\
            --tree {input.tree} \\
            --output {output.tree} \\
            --outgroup s1 \\
            --merged > {log} 2>&1
        """

# Score SCM's inferred mutation origins against the simulated truth.
rule compare_scm:
    input:
        vcf     = rules.simulate_ground_truth.output.vcf,
        truth   = rules.simulate_ground_truth.output.truth,
        h5      = rules.merge_scm_h5.output.h5,
        scm_tree = rules.write_scm_tree.output.tree,
        rsimpop = "results/rsimpop_installed.txt",
        script  = "workflow/bin/compare_scm.Rscript"
    output:
        tsv = "results/scm/compare/n{n}_t{t}_v{viol_mult}_r{rep}.tsv"
    conda: "envs/simulate_history.yaml"
    threads: 4
    resources:
        mem_mb = lambda wildcards, attempt: 4000 * attempt
    log: "logs/compare_scm/n{n}_t{t}_v{viol_mult}_r{rep}.log"
    shell:
        """
        Rscript {input.script} \\
            --vcf {input.vcf} \\
            --truth {input.truth} \\
            --scm_tree {input.scm_tree} \\
            --h5 {input.h5} \\
            --out {output.tsv} \\
            --threads {threads} > {log} 2>&1
        """
